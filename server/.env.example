# ===== Copiá este archivo a ".env" (sin el ".example") y completá con tus datos reales =====
# Este archivo NO se sube a ningún lado ni se manda a nadie: vive solo en tu PC,
# al lado de server.js, y server.js lo lee para saber cómo conectarse a tu SQL Server.

# --- SQL Server ---
DB_SERVER=NOMBRE_O_IP_DE_TU_SERVIDOR
DB_DATABASE=NOMBRE_DE_TU_BASE
DB_PORT=1433

# Si te conectás con usuario y contraseña de SQL Server, completá estos dos:
DB_USER=
DB_PASSWORD=
# Si en cambio usás autenticación de Windows (trusted connection), dejá los dos
# de arriba VACÍOS y poné esto en true:
DB_TRUSTED_CONNECTION=false
# Aceptar el certificado del SQL Server sin verificarlo (vale para los dos
# servidores, el principal y el de Calendario). true = como siempre, sirve
# con los certificados propios de los servidores internos. Si sistemas
# instala un certificado válido, ponelo en false: así nadie en la red puede
# hacerse pasar por el servidor SQL.
DB_TRUST_SERVER_CERTIFICATE=true

# --- De dónde sale el contenido de cada DXF ---
# "file" (default): el DXF es un archivo de red — la columna "archivo"
#        (Desenho_Path en tu consulta) ya trae la ruta COMPLETA
#        (ej. \\SERVIDOR\cnc-revisados\...) y se usa tal cual, sin
#        sumarle nada. DXF_BASE_PATH de abajo solo se usa si algún día
#        esa columna trajera nombres sueltos en vez de rutas completas.
# "sql":  el DXF está guardado ADENTRO de la fila de tu tabla (una
#        columna de texto o binaria) — completá "dxfPorOrden" en
#        queries.js si volvés a este modo.
DXF_SOURCE=file

# --- Carpeta compartida donde viven los DXF de las órdenes ---
# Solo se usa si la columna "archivo" trae un nombre suelto SIN ruta
# (con DXF_SOURCE=file). Si ya te vienen rutas completas de red (tu
# caso), esto no hace falta — podés dejarlo como está. Ejemplos válidos
# en Windows si alguna vez hiciera falta:
#   \\SERVIDOR\Ordenes\DXF
#   Z:\Ordenes\DXF
DXF_BASE_PATH=\\SERVIDOR\CAMBIAR\ESTA\RUTA

# --- Nesting de Tecoflex: carpeta con un DXF por medida ---
# Cada medida tiene su archivo ("CORTE 9MM UND.dxf": una tira de 9 mm de ancho
# por 3000 de largo). Si no la completás, se usa la de abajo. Tiene que estar
# dentro de una de las carpetas de DXF_ALLOWED_PREFIXES.
# TECOFLEX_DXF_CARPETA=\\192.168.2.2\cnc-revisados\OPTIMIZACION TECO

# --- MUY RECOMENDADO: a qué carpetas de red puede apuntar "archivo"
# cuando viene como ruta completa (ver arriba) ---
# El parámetro "archivo" lo manda el navegador en la URL: alguien YA
# logueado podría pedir otra ruta a mano. El puente ya rechaza siempre lo
# que no sea .dxf, los ".." y la carpeta de la app; con esto, además, solo
# acepta rutas DENTRO de estas carpetas (separadas por coma). Vacío, una
# PC del puente podría terminar conectándose a una carpeta de red de
# cualquier máquina que alguien escriba (y entregarle sin querer el hash
# de la contraseña de Windows). El puente avisa al arrancar si está vacío.
DXF_ALLOWED_PREFIXES=\\SERVIDOR\carpeta-de-los-dxf

# --- Cuánto esperar a SQL Server antes de avisar "Timeout" (opcional) ---
# El driver trae 15 segundos por default para conectar y para que una
# consulta termine — si tu red/VPN es lenta, o la vista de componentes
# es pesada, a veces no alcanza y corta con "Timeout: Request failed to
# complete in 15000ms" aunque SQL esté bien. Por default la app ya usa
# valores más generosos (60s para consultas, 30s para conectar) sin que
# haga falta tocar nada acá — estas dos líneas son solo por si con eso
# TODAVÍA no alcanza y querés subirlo más (el número es en milisegundos,
# 60000 = 1 minuto).
DB_REQUEST_TIMEOUT_MS=60000
DB_CONNECTION_TIMEOUT_MS=30000

# --- Segundo servidor SQL, SOLO para traer Puestodetrabajo (opcional) ---
# Es un servidor DISTINTO al de arriba (el de Calendario). Si lo dejás
# vacío (CAL_DB_SERVER sin completar), esto queda desactivado solo: la
# columna Puestodetrabajo llega vacía en la app, pero el resto de la
# lista de corte sigue funcionando igual. Mismo criterio que arriba para
# usuario/contraseña vs. autenticación de Windows.
CAL_DB_SERVER=
CAL_DB_DATABASE=
CAL_DB_PORT=1433
CAL_DB_USER=
CAL_DB_PASSWORD=
CAL_DB_TRUSTED_CONNECTION=false

# --- Puerto en el que corre este puente (la app le va a pedir datos acá) ---
PORT=4000

# --- Clave opcional para hablarle al puente (recomendado si tu red no es
# de confianza total) --- Si la completás acá, la app también tiene que
# tener la MISMA clave cargada (campo "Clave del puente" en Lista de
# corte). Dejala vacía para no pedir nada.
API_TOKEN=

# --- Usuarios: SOLO para el PRIMER arranque ---
# La primera vez que arranca el puente, estos usuarios se copian a
# server/usuarios.json (con la contraseña cifrada). "hfrodriguez" queda como
# administrador. Desde ahí en adelante los usuarios, contraseñas y permisos
# se manejan desde la app (pestaña "Usuarios") y esta línea ya no se usa.
# Formato: "Nombre:clave" separados por coma.
AUTH_USUARIOS=
# Si lo dejás vacío, nadie puede entrar a esas 3 pestañas (van a pedir
# iniciar sesión pero no va a haber ningún usuario válido) — completalo
# antes de que alguien lo necesite.
AUTH_USUARIOS=

# --- Órdenes "especiales" que entran a Lista de corte por ZFER (no por
# Operation 0132) --- Además de las órdenes normales (Operation 0132),
# la app suma las que en Calendario (BUSCARV, ver columnaZfer en
# queries.js) tengan alguno de estos códigos de ZFER — se completa su
# archivo/ruta con la fila de la Operation que pongas en
# OPERATION_PARA_ORDENES_ZFER (no con Operation 0132).
# Si te aparece un ZFER nuevo, agregalo ACÁ (separado por coma si son
# varios) — no hace falta tocar ningún archivo de código:
#   ZFER_LISTA_ESPECIAL=70005171,70005180,70005199
ZFER_LISTA_ESPECIAL=70005171
# De qué Operation (dentro de tu vista real) sacar el archivo/ruta para
# esas órdenes especiales. Normalmente no hace falta tocar esto.
OPERATION_PARA_ORDENES_ZFER=0101

# --- Freno de seguridad: por defecto, este puente NUNCA escribe nada en
# tu SQL — ni la lista de corte ni Calendario, los dos son de SOLO
# LECTURA siempre. El Rack se maneja simulado, en el navegador. Si algún
# día conseguís permiso para crear la tabla de control
# (server/sql/crear_tabla_control.sql) y de verdad querés que el Rack
# también escriba en SQL, tenés que cambiar esto a true A PROPÓSITO —
# no alcanza con destildar la casilla "Simular el Rack" en la pantalla,
# hace falta las DOS cosas.
PERMITIR_ESCRITURA_SQL=false

# --- Impresión directa de stickers en tu Zebra (opcional) ---
# Solo hace falta si querés que los stickers salgan solos al confirmar
# un lote, sin abrir ningún PDF. Requiere: 1) la Zebra instalada en
# Windows en modo "Generic / Text Only" (no el driver gráfico normal),
# y 2) esa impresora COMPARTIDA (aunque sea en la misma PC) — ver el
# paso a paso en CONECTAR_SQL.md. Poné acá el nombre exacto que le
# diste al compartirla (no el nombre del modelo, el nombre del recurso
# compartido). Si lo dejás vacío, esto queda desactivado y la app usa
# el PDF de stickers como respaldo.
ZEBRA_PRINTER_SHARE=

# --- Migración de los racks a SQL Server (solo para tools/migracion/migrar-a-sql.js) ---
# La base PROPIA de la app (no SAGA ni Calendario), con las tablas de
# server/sql/propuesta_tablas_racks.sql ya creadas. Usuario con permiso de
# escritura solo sobre esa base. Ver tools/migracion/README.md.
MIG_DB_SERVER=
MIG_DB_DATABASE=
MIG_DB_PORT=1433
MIG_DB_USER=
MIG_DB_PASSWORD=
MIG_DB_TRUSTED_CONNECTION=false

# --- Lista de corte: cada cuánto se consulta SQL (protege al SQL) ---
# Todas las PCs ven la ÚLTIMA lista consultada, guardada en el puente. SQL
# se consulta como mucho una vez por este período, sin importar cuántas
# personas toquen "Actualizar". Solo un administrador puede forzarla antes
# (botón "Forzar actualización desde SQL"), y no más de una vez cada
# LISTA_FORZAR_CADA_S segundos. Si SQL falla, se sigue mostrando la última
# lista buena y se reintenta cada 2 minutos (no en cada pedido).
LISTA_ACTUALIZAR_MIN=60
LISTA_FORZAR_CADA_S=30
# Ingreso rápido y lote por código sí consultan SQL (consultas chicas):
# tope por persona, por minuto.
BUSQUEDAS_POR_MINUTO=40

# --- Nombre correcto de los componentes de Mallas y Tejidos (opcional) ---
# En SAGA, los CodMat que empiezan por 0000000006 a veces traen un nombre que
# no es el original (ej. "ZHAL BUFFER ACEROS CO"). La tabla dbo.ODATA_Fullkit
# (en agpcol.database.windows.net, otra base) tiene el nombre bien con el
# mismo código. Completá servidor y base para activarlo (es OTRO servidor que
# Calendario). Usuario y clave: si los dejás vacíos se usan los de Calendario.
# Si no se completa o falla, se sigue mostrando el nombre de SAGA.
FULLKIT_DB_SERVER=agpcol.database.windows.net
FULLKIT_DB_DATABASE=agpc-productivity
FULLKIT_DB_USER=
FULLKIT_DB_PASSWORD=
